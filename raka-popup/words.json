 "sentences": [
  {
   "start": 0.14,
   "end": 1.84,
   "text": "Raka diam 10 menit di rapat.",
   "w0": 0,
   "w1": 5
  },
  {
   "start": 2.34,
   "end": 5.1,
   "text": "Idenya dipakai, tapi bukan dia yang ngomong.",
   "w0": 6,
   "w1": 12
  },
  {
   "start": 5.64,
   "end": 9.58,
   "text": "Padahal dari jam 9 pagi, ide itu udah ada di kepalanya.",
   "w0": 13,
   "w1": 23
  },
  {
   "start": 10.06,
   "end": 12.4,
   "text": "Tapi satu pikiran bikin dia nahan diri.",
   "w0": 24,
   "w1": 30
  },
  {
   "start": 13.04,
   "end": 14.18,
   "text": "Nanti dibilang sok tahu.",
   "w0": 31,
   "w1": 34
  },
  {
   "start": 14.8,
   "end": 16.56,
   "text": "Jadi dia diam.",
   "w0": 35,
   "w1": 37
  },
  {
   "start": 17.02,
   "end": 21.38,
   "text": "Sampai temannya ngomong ide yang mirip, dan semua orang mengangguk.",
   "w0": 38,
   "w1": 47
  },
  {
   "start": 21.82,
   "end": 24.28,
   "text": "Malamnya Raka nanya ke dirinya sendiri.",
   "w0": 48,
   "w1": 53
  },
  {
   "start": 24.86,
   "end": 27.72,
   "text": "Aku ini rendah hati, atau cuma takut?",
   "w0": 54,
   "w1": 60
  },
  {
   "start": 28.12,
   "end": 29.16,
   "text": "Pelan-pelan dia paham.",
   "w0": 61,
   "w1": 63
  },
  {
   "start": 29.6,
   "end": 36.82,
   "text": "Rendah hati itu soal cara kita memandang orang, sedangkan pede soal berani menawarkan yang kita punya.",
   "w0": 64,
   "w1": 79
  },
  {
   "start": 37.16,
   "end": 40.28,
   "text": "Dua-duanya bisa jalan bareng.",
   "w0": 80,
   "w1": 83
  },
  {
   "start": 40.38,
   "end": 42.88,
   "text": "Rapat berikutnya, Raka cuma butuh satu kalimat.",
   "w0": 84,
   "w1": 90
  },
  {
   "start": 43.26,
   "end": 44.52,
   "text": "Aku punya satu usulan.",
   "w0": 91,
   "w1": 94
  },
  {
   "start": 44.9,
   "end": 47.5,
   "text": "Kalau kamu pernah jadi Raka, kamu gak sendirian.",
   "w0": 95,
   "w1": 102
  },
  {
   "start": 47.88,
   "end": 51.26,
   "text": "Follow, biar di rapat berikutnya, kamu yang ngomong.",
   "w0": 103,
   "w1": 110
  }
 ],
