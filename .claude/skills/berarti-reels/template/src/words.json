 "sentences": [
  {
   "start": 0.06,
   "end": 5.76,
   "text": "Berhenti buka presentasi pakai, \"perkenalkan, nama saya.\" Ganti satu kalimat ini.",
   "w0": 0,
   "w1": 10
  },
  {
   "start": 6.28,
   "end": 10.8,
   "text": "Di detik-detik pertama, audiens lagi mutusin kamu layak didengerin, atau nggak.",
   "w0": 11,
   "w1": 21
  },
  {
   "start": 11.2,
   "end": 13.16,
   "text": "Dan nama kamu belum jadi alasan.",
   "w0": 22,
   "w1": 27
  },
  {
   "start": 13.513,
   "end": 16.042,
   "text": "Ganti dengan satu kalimat masalah yang mereka rasain.",
   "w0": 28,
   "w1": 35
  },
  {
   "start": 16.184,
   "end": 17.839,
   "text": "Misalnya presentasi soal keuangan.",
   "w0": 36,
   "w1": 39
  },
  {
   "start": 18.026,
   "end": 20.846,
   "text": "\"Siapa yang gajian tanggal dua puluh lima, tapi tanggal sepuluh...",
   "w0": 40,
   "w1": 49
  },
  {
   "start": 21.246,
   "end": 23.05,
   "text": "udah bingung?\" Kasih jeda dua detik.",
   "w0": 50,
   "w1": 55
  },
  {
   "start": 23.43,
   "end": 24.35,
   "text": "Biarin mereka mikir.",
   "w0": 56,
   "w1": 58
  },
  {
   "start": 24.77,
   "end": 30.21,
   "text": "Baru setelah itu, \"Saya Firas, dan hari ini kita beresin itu.\" Namamu tetap disebut.",
   "w0": 59,
   "w1": 72
  },
  {
   "start": 30.51,
   "end": 32.91,
   "text": "Cuma sekarang, orang punya alasan buat inget.",
   "w0": 73,
   "w1": 79
  },
  {
   "start": 33.25,
   "end": 35.23,
   "text": "Simpan ini buat presentasi kamu berikutnya.",
   "w0": 80,
   "w1": 85
  }
 ],
