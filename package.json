{
  "name": "albahjah-manasik-umroh-bumper",
  "version": "1.0.0",
  "private": true,
  "description": "AL-BAHJAH MANASIK UMROH - 40s cinematic event bumper built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AlBahjahBumper out/ALBAHJAH_MANASIK_UMROH_BUMPER_40S.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --browser-executable=${REMOTION_BROWSER:-/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell}",
    "render:preview": "remotion render src/index.ts AlBahjahBumper out/preview_960x540.mp4 --codec=h264 --scale=0.5 --crf=22 --browser-executable=${REMOTION_BROWSER:-/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell}",
    "stills": "node scripts/render-stills.mjs",
    "audio": "python3 scripts/generate_audio.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.545",
    "@remotion/cli": "^4.0.545",
    "@remotion/fonts": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3"
  }
}
